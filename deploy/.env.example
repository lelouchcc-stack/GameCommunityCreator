# =============================================================================
# GameCommunityCreator-MVP 部署环境变量示例
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   修改 MYSQL_ROOT_PASSWORD 后执行 docker compose up -d --build
#
# .env 含密码，已被根目录 .gitignore 忽略，不要提交到版本库。
# 本文件只是示例：校验 compose 配置时可 --env-file .env.example（无真实密码）。
# =============================================================================

# 必填：MySQL root 密码（示例值不可用于生产，请改成自己的强密码）
MYSQL_ROOT_PASSWORD=change-me-before-deploy

# 数据库名（与 database/schema.sql 中的库名保持一致，默认 gcc_mvp）
MYSQL_DATABASE=gcc_mvp

# 宿主机端口映射（被占用时改这里）
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=80

# 后端 CORS 白名单（生产环境同源部署时只需填前端访问地址）
CORS_ALLOWED_ORIGINS=http://localhost

# ---------------------------------------------------------------------------
# 认证配置（首次启动必须提供初始开发者，否则旧项目 owner_user_id 为空、管理端不可见）
# ---------------------------------------------------------------------------
# 初始开发者用户名（3-30 位字母/数字/下划线/中划线）
APP_BOOTSTRAP_USERNAME=dev
# 初始开发者密码（>=8 位且同时含字母与数字；示例值仅占位，部署前必须改成自己的强密码）
APP_BOOTSTRAP_PASSWORD=change-me-strong-password
# 初始开发者显示名（可选）
APP_BOOTSTRAP_DISPLAY_NAME=独立开发者

# v4.1 Sa-Token JWT 插件签名密钥（HS256，>=32 字节；对应 sa-token.jwt-secret-key）。
# 生产环境必须改成随机强密钥（如 openssl rand -base64 48），示例值不可用于生产；
# 密钥泄露等同于登录态可被伪造。Sa-Token 的登录态由服务端保存（Simple 模式），默认内存，多实例需接 Redis 插件。
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
# 登录态有效期（秒，默认 7200 = 2 小时；对应 sa-token.timeout，不自动续签）
SA_TOKEN_TIMEOUT=7200
