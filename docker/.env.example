# 复制到仓库根目录再改：cp docker/.env.example .env（Windows: copy docker\.env.example .env）
# 根目录的 .env 已在 .gitignore 里，不会被提交；本文件只是模板，别把真实口令写回这个文件。

# 数据库 root 口令。容器**首次**初始化时写入；数据卷建好之后再改这里不会生效
# （要改得 docker compose down -v 清掉数据卷重建，注意那会连库数据一起删）
DB_ROOT_PASSWORD=change-me-db-root-password

# 后台令牌签名密钥。生成一个：openssl rand -hex 32
# 留空或继续用这串占位值等于把后台交给别人——泄露了任何人都能自己签出管理员令牌
JWT_SECRET=change-me-openssl-rand-hex-32

# 对外端口（用户端 / 管理端）
USER_PORT=80
ADMIN_PORT=8081

# 后端接口只绑在宿主机回环上，供调试用。默认 9331 与本地开发的后端一样，
# 如果本机正跑着开发用的后端，改成别的（比如 19331）再 up，否则端口冲突起不来。
BACKEND_PORT=9331

# 后端 JVM 内存。小内存机器（1G）建议 -Xms128m -Xmx384m；镜像默认是 -Xms256m -Xmx512m
JAVA_OPTS=-Xms256m -Xmx512m
