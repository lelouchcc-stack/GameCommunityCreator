{
  "schemaVersion": 2,
  "pageId": "{{pageId}}",
  "pageTitle": "{{pageTitle}}",
  "projectSlug": "{{slug}}",
  "theme": {
    "primaryColor": "#5B8CFF",
    "accentColor": "#9B5CFF",
    "backgroundColor": "#0B1020",
    "surfaceColor": "#151B33",
    "textColor": "#E8ECFF",
    "mutedTextColor": "#9AA6CC",
    "fontFamily": "system",
    "borderRadius": 16
  },
  "components": [
    {
      "id": "cmp_default_docs",
      "type": "docs_list",
      "title": "公开文档",
      "visible": true,
      "dataSource": "docs",
      "props": {
        "limit": 8,
        "category": ""
      }
    },
    {
      "id": "cmp_default_footer",
      "type": "footer",
      "title": "页脚",
      "visible": true,
      "dataSource": null,
      "props": {
        "copyright": "© 2025 {{gameName}} 社区",
        "note": "由 GameCommunityCreator 可视化搭建"
      }
    }
  ]
}
